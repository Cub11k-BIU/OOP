<project name="Assignment7" default="run" basedir=".">

    <!-- ===================================================================== -->
    <!-- Project properties                                                    -->
    <!-- ===================================================================== -->
    <description>
        This build file runs and tests the Assignment 7 LRU cache.
        Unlike the Java assignments, A7 is a Python project — there is
        no compile step, no JAR packaging, and no checkstyle. Each
        target shells out to the Python interpreter via &lt;exec&gt;.

        Key targets:
        - clean: Deletes Python bytecode caches and build artifacts.
        - compile: No-op (Python is interpreted; kept for convention).
        - test: Runs unittest discovery (picks up any test_*.py files).
        - run: Runs the main.py demonstration script.
    </description>

    <!-- The Python interpreter. On Windows the launcher is `py`; on
         Linux/macOS it is typically `python3`. Override on the command
         line with `-Dapp.python.exec=python3` if needed. -->
    <property name="app.python.exec" value="python3"/>

    <!-- Source files (locked by Assignment-7.md) -->
    <property name="src.file" value="lru_cache.py"/>
    <property name="main.file" value="main.py"/>

    <!-- Output directories (only used by clean) -->
    <property name="output.dir" value="${basedir}/build"/>

    <!-- ===================================================================== -->
    <!-- Core Build Targets                                                    -->
    <!-- ===================================================================== -->

    <target name="clean" description="Delete Python bytecode caches and build artifacts">
        <delete dir="${output.dir}"/>
        <delete dir="${basedir}/__pycache__"/>
        <delete includeemptydirs="true">
            <fileset dir="${basedir}" includes="**/__pycache__/**" defaultexcludes="no"/>
            <fileset dir="${basedir}" includes="**/*.pyc" defaultexcludes="no"/>
        </delete>
    </target>

    <target name="compile" description="No-op for Python — kept for ant target convention">
        <echo message="Python is interpreted; nothing to compile."/>
    </target>

    <!-- ===================================================================== -->
    <!-- Run target                                                            -->
    <!-- ===================================================================== -->

    <target name="run" description="Run the main.py demonstration script">
        <exec executable="${app.python.exec}" failonerror="true">
            <arg value="${main.file}"/>
        </exec>
    </target>

    <!-- ===================================================================== -->
    <!-- Testing target                                                        -->
    <!-- ===================================================================== -->

    <target name="test" description="Run unittest discovery (picks up any test_*.py)">
        <exec executable="${app.python.exec}" failonerror="true">
            <arg value="-m"/>
            <arg value="unittest"/>
            <arg value="discover"/>
            <arg value="-v"/>
        </exec>
    </target>

</project>
